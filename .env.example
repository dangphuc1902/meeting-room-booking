# Copy to .env and adjust. docker compose reads .env automatically.
# Every value has a working default, so `docker compose up` also runs without a .env file.

DB_NAME=meeting_room
DB_USER=meeting
DB_PASSWORD=meeting
DB_PORT=5432
APP_PORT=8080

# "demo" seeds 10 sample rooms and a demo user. Use "default" for an empty database.
SPRING_PROFILES_ACTIVE=demo

# HS256 key: at least 32 bytes. Generate one with: openssl rand -base64 48
JWT_SECRET=local-dev-only-secret-change-me-0123456789abcdef

# First admin account, created on startup only if no admin exists yet.
ADMIN_EMAIL=admin@company.local
ADMIN_PASSWORD=Admin@123
